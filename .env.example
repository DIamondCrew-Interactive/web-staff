# Staff is public even with empty Discord settings. Server-only credentials.
APP_VARIANT=staff
PORT=3000
PROXY_NETWORK=diamondcrew-proxy
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://staff.diamondcrew.net/auth/discord/callback
# Comma-separated IDs. Empty locks the staff reader. Safe AI read routes remain public.
DISCORD_ALLOWED_USER_IDS=
# Server-side session signing key. Generate with: openssl rand -hex 32
# Empty uses an ephemeral random key; it never prevents public startup.
SESSION_SECRET=
# Local OAuth callback: http://localhost:3000/auth/discord/callback

# Optional monitoring. Missing configuration produces UNKNOWN, not demo data.
PTERODACTYL_URL=
PTERODACTYL_CLIENT_API_KEY=
STATUS_TARGETS=[]
# IDs: prismatic-prod, prismatic-dev, diamond-prod, diamond-dev, minecraft, dia-01
# STATUS_TARGETS='[{"id":"prismatic-dev","pterodactylId":"abcdefgh","fivemUrl":"http://game-host:30131"},{"id":"dia-01","healthUrl":"http://health-agent:8080/healthz"},{"id":"minecraft","maintenance":true}]'
# HTTP probe URLs allow a path, but no credentials, query or fragment.
# Minecraft: Pterodactyl status or an existing HTTP exporter; no invented players.

# These announcements are PUBLIC. Never enter internal addresses or secrets.
PUBLIC_INCIDENT_TITLE=
PUBLIC_INCIDENT_MESSAGE=
PUBLIC_MAINTENANCE=false
PUBLIC_MAINTENANCE_MESSAGE=
