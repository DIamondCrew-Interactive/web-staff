# Local dev: staff on http://localhost:3000. Use a second terminal for public.
PORT=3000
APP_VARIANT=staff
DATA_MODE=demo

# Required in production. Leave empty only during local development.
# Generate a random password, 20+ characters. Do not commit .env.
# Set both to enable Basic authentication in development as well.
STAFF_USERNAME=
STAFF_PASSWORD=

# Docker network shared with Nginx Proxy Manager. No host ports are published.
PROXY_NETWORK=diamondcrew-proxy

# SERVER ONLY. Use a dedicated Pterodactyl account with minimum read permissions.
# Origin only, HTTPS required. Use a Client API key, not an Application API key.
PTERODACTYL_URL=
PTERODACTYL_CLIENT_API_KEY=
# Client server identifier (not numeric Application API id).
# FiveM URL is optional and only used by the backend; HTTP on private networks is allowed.
PTERODACTYL_SERVERS=[]
# Example (one line, wrap JSON in single quotes):
# PTERODACTYL_SERVERS='[{"id":"abcdefgh","name":"Prismatic Roleplay","project":"Prismatic Roleplay","environment":"DEV","port":30131,"node":"DIA-01","fivemUrl":"http://your-private-game-host:30131"}]'

# These texts are PUBLIC. Never enter internal addresses or confidential details.
PUBLIC_INCIDENT_TITLE=
PUBLIC_INCIDENT_MESSAGE=
PUBLIC_MAINTENANCE=false
PUBLIC_MAINTENANCE_MESSAGE=
