# Separate deployment on the chosen CDN VPS. Never assume DIA-01.
PORT=3002
IMAGE_STORAGE_ROOT=./.media
IMAGE_PUBLIC_URL=https://img.dcrp.cz
IMAGE_MAX_UPLOAD_MB=25
IMAGE_MAX_BATCH_MB=50
IMAGE_MAX_BATCH_FILES=10
IMAGE_CACHE_SECONDS=300
PROXY_NETWORK=diamondcrew-proxy
# Local public URL: http://localhost:3002

# Central SSO is configured by a private runtime file; empty disables management sign-in.
IMAGE_SSO_CONFIG_FILE=
# Optional docker-compose.image-sso.yml uses an absolute private host directory.
IMAGE_SSO_CREDENTIAL_DIRECTORY=

# Explicit trusted reverse-proxy IP/CIDRs only; empty ignores forwarding headers.
TRUST_PROXY_CIDRS=
