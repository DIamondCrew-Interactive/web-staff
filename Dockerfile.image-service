FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY src ./src
COPY server ./server
COPY scripts ./scripts
COPY public ./public
COPY docs/internal ./docs/internal
COPY index.html public.html image.html vite.config.ts tsconfig.json tsconfig.server.json ./
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine AS runtime
ENV NODE_ENV=production PORT=3000 IMAGE_STORAGE_ROOT=/media
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/build/server ./build/server
COPY --from=build --chown=node:node /app/build/src ./build/src
COPY --from=build --chown=node:node /app/build/scripts ./build/scripts
COPY --from=build --chown=node:node /app/dist/image ./dist/image
RUN mkdir /media && chown node:node /media && chmod 750 /media
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "build/server/image.js"]
